# ========================================================
# 🚀 JIRA QA ANALYTICS ENGINE & TELEGRAM BOT CONFIGURATION
# ========================================================

# App Branding
APP_NAME="Jira QA Analytics"

# Jira Cloud API Credentials
# Get your API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_API_TOKEN="your_jira_api_token"
JIRA_PROJECT="YOUR_PROJECT_KEY"

# Optional: Jira Reporter Filter (Leave blank to automatically detect your logged-in Jira user)
JIRA_REPORTER_ID=""
JIRA_PLATFORM_FIELD="components"

# Telegram Bot Credentials
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-100123456789"

# Automatic Broadcast Schedules (Asia/Tashkent or your local timezone)
DAILY_REPORT_HOUR="19"
DAILY_REPORT_MINUTE="00"
TIMEZONE="Asia/Tashkent"

# Local Express Server Config
PORT=3000
DATABASE_PATH="data/jira_qa.sqlite"
